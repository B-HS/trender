{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@app/*": [
        "./app/*"
      ],
      "@entities/*": [
        "./entities/*"
      ],
      "@features/*": [
        "./features/*"
      ],
      "@widgets/*": [
        "./widgets/*"
      ],
      "@workflows/*": [
        "./workflows/*"
      ],
      "@lib/*": [
        "./lib/*"
      ],
      "@ui/*": [
        "./ui/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "drizzle",
    "tests"
  ]
}
