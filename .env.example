DATABASE_URL=mysql://user:password@host:3306/trender

# LLM 어댑터 우선순위 (콤마 구분, 첫째가 primary). 비어있는 어댑터는 자동 스킵.
LLM_PROVIDERS=ollama_cloud,omlx_local,openrouter,openai_oauth,ollama_local

# --- Ollama Cloud ---
OLLAMA_CLOUD_KEY=
OLLAMA_CLOUD_HOST=https://ollama.com
# 리포트(요약)용 무거운 모델
OLLAMA_CLOUD_MODEL=deepseek-v4-flash:cloud
# 키워드 추출 + 번역용 경량 모델 (미지정 시 OLLAMA_CLOUD_MODEL 로 폴백)
OLLAMA_CLOUD_MODEL_LIGHT=gemma4:31b-cloud

# --- Ollama Local ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_LOCAL_MODEL=llama3.1:8b

# --- OMLX Local (jundot/omlx — Apple Silicon 메뉴바 LLM 서버, OpenAI 호환) ---
# https://github.com/jundot/omlx 설치 후 메뉴바에서 모델 로드 → 기본 포트 8080
OMLX_HOST=http://localhost:8080
OMLX_MODEL=mlx-community/Qwen2.5-32B-Instruct-4bit

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_HOST=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=trender
# OPENROUTER_REFERER=https://your-site.com

# --- OpenAI OAuth (Codex CLI 로그인) ---
# 둘 중 하나만 채우면 됨:
#   1) `codex login` 실행해 ~/.codex/auth.json 생성 (자동 인식)
#   2) 직접 토큰을 OPENAI_OAUTH_TOKEN 에 세팅
OPENAI_OAUTH_MODEL=gpt-4o-mini
OPENAI_OAUTH_BASE_URL=https://api.openai.com/v1
# OPENAI_OAUTH_TOKEN=
# OPENAI_OAUTH_AUTH_FILE=~/.codex/auth.json

# --- 수집 옵션 ---
FETCH_CONCURRENCY=4
FETCH_TIMEOUT_SECONDS=30
FETCH_PER_SOURCE_LIMIT=20
LOG_LEVEL=INFO
